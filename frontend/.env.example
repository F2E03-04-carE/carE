# Supabase 配置
# 請複製此檔案為 .env 並填入您的實際金鑰
# Supabase Key (在上方列表的Connect -> App Frameworks -> 選擇Vue.js)

VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# 後端 API URL
# 開發環境使用本地後端，生產環境使用部署的後端
VITE_API_URL=http://localhost:3000

# Google 網站驗證金鑰
VITE_GOOGLE_SITE_VERIFICATION=your_google_site_verification_key


VITE_CLOUDINARY_CLOUD_NAME=你的cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=garages_unsigned
VITE_CLOUDINARY_API_KEY=你的api_key
